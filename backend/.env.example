# Secret used to sign JWT access tokens. Required; at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Access-token lifetime in minutes.
JWT_EXPIRE_MINUTES=60

# Comma-separated browser origins allowed to call the API (no wildcards).
CORS_ORIGINS=http://localhost:5173

# TMDB v4 read access token (https://www.themoviedb.org/settings/api).
# Used only by the backend /tmdb proxy; never expose it to the frontend.
TMDB_TOKEN=

# ── Data and models ──────────────────────────────────────────────────────────
# Directory with item_features_final.csv, user_features_final.csv and the
# SQLite database. Model paths default to files in this directory.
DATA_DIR=../data
MODEL_PATH=../data/bert4rec_v3.onnx
SASREC_MODEL_PATH=../data/sasrec_v3.onnx

# SQLAlchemy database URL. Defaults to SQLite at $DATA_DIR/streamora.db.
# Migrations run automatically at startup.
# DATABASE_URL=sqlite:////absolute/path/to/streamora.db

# ── Recommendation behaviour ─────────────────────────────────────────────────
# History titles that must match the catalogue before a model is used;
# below this, popular unwatched titles are returned instead.
MIN_SEQUENCE_LENGTH=5
RECOMMENDATION_CACHE_TTL_SEC=3600
# How long a thumbs-down keeps a title out of a profile's recommendations.
DISLIKE_SUPPRESSION_DAYS=30

# ── Optional services ────────────────────────────────────────────────────────
# Redis enables caching, dislike suppression and Thompson-sampling routing.
# Leave empty to disable.
REDIS_URL=redis://localhost:6379
# Kafka publishes feedback events to the 'user_feedback' topic. No consumer is
# included in this repository. Leave empty to disable.
KAFKA_BOOTSTRAP=
