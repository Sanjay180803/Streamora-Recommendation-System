# Docker Compose settings. Copy to .env and fill in.
# For running the backend without Docker, see backend/.env.example.

# Required: at least 32 characters.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# TMDB v4 read access token; used only by the backend proxy.
TMDB_TOKEN=

# Where browsers load the frontend from, and where they reach the API.
# On a server, use its public address, e.g. http://203.0.113.10
CORS_ORIGINS=http://localhost
VITE_API_BASE_URL=http://localhost:8000

# Optional: set to kafka:9092 when starting with --profile kafka
KAFKA_BOOTSTRAP=
